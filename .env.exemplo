# Credenciais do Meta Ads — copie este arquivo para .env e preencha.
#
# Sao duas obrigatorias e uma opcional:
#   META_ADS_TOKEN       -> "quem esta batendo, e o que pode fazer?"   (usuario do sistema)
#   META_APP_ID          -> "por qual aplicativo?"                     (Meta for Developers)
#   META_AD_ACCOUNT_ID   -> "em qual conta de anuncio?"                (opcional)
#
# O passo a passo de cada uma esta em docs/01-criar-o-app-na-meta.md.
# Este arquivo NAO entra no git — o .gitignore ja barra o .env.

# o token do usuario do sistema. E ELE que gasta dinheiro — nunca versione
META_ADS_TOKEN=""

# o numero do seu aplicativo. developers.facebook.com > Meus Apps
META_APP_ID=""

# conta padrao, com o act_ na frente. Evita passar --account toda vez
META_AD_ACCOUNT_ID=""
